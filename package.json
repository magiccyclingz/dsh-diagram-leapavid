{
  "name": "dsh-diagram-leapavid",
  "version": "0.4.3",
  "type": "module",
  "description": "Diagram LeapAvid — browse 50 editorial diagram types, pick from 10 brand palettes, and generate single-file HTML diagrams with a bundled diagram-design spec and progressive prompt injection; no external skill or plugin required.",
  "author": "LeapAvid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magiccyclingz/dsh-diagram-leapavid.git"
  },
  "homepage": "https://github.com/magiccyclingz/dsh-diagram-leapavid#readme",
  "bugs": {
    "url": "https://github.com/magiccyclingz/dsh-diagram-leapavid/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "icon.png",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "docs",
    "locale",
    "lib",
    "screenshots.json",
    "palettes.json",
    "scripts",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node scripts/test-palettes.mjs && node scripts/test-prompt.mjs && node scripts/test-access.mjs",
    "sync-skill": "node scripts/sync-skill.mjs"
  }
}
